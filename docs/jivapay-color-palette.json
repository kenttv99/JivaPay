        "name": "Success Green",
        "hex": "#10B981",
        "rgb": "rgb(16, 185, 129)",
        "rgbValues": [16, 185, 129],
        "usage": "Успешные операции, положительные состояния"
      },
      "error": {
        "name": "Error Red",
        "hex": "#EF4444",
