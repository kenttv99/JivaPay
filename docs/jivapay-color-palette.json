  "usageGuidelines": {
    "lightColors": {
      "colors": ["shadyLady", "ghost"],
      "purpose": "Фоновая база интерфейса"
    },
    "darkColors": {
      "colors": ["richBlack"],
      "purpose": "Элементы интерфейса, текст, компоненты"
    },
    "accentColors": {
      "colors": ["toryBlue"],
      "purpose": "Выборочные элементы, логотип, акценты"
    },
    "semanticColors": {
      "colors": ["success", "error", "warning"],
      "purpose": "Статусы операций и уведомления"
    }
  },
  "tailwindIntegration": {
    "description": "Интеграция с Tailwind CSS конфигурацией",
    "configPath": "frontend/tailwind.config.base.ts",
    "customColors": {
      "shady-lady": "#ACA9AC",
      "ghost": "#C6CED8",
      "rich-black": "#232525",
      "tory-blue": "#0E44B7"
    },
    "cssVariables": {
      "--color-success": "#10B981",
      "--color-error": "#EF4444",
      "--color-warning": "#F59E0B",
      "--color-primary": "var(--color-primary)",
      "--color-secondary": "var(--color-secondary)",
      "--color-bg": "var(--color-bg)"
    }
  },
  "accessibility": {
    "contrastRatios": {
      "richBlackOnShadyLady": "High contrast for text readability",
      "toryBlueOnWhite": "WCAG AA compliant",
      "semanticColors": "Designed for accessibility standards"
    },
    "colorBlindness": {
      "note": "Palette tested for common color vision deficiencies",
      "alternatives": "Semantic colors include sufficient contrast differences"
    }
  },
  "brandingNotes": {
    "primaryBrand": "toryBlue",
    "logoColors": ["toryBlue", "richBlack"],
    "backgroundHierarchy": ["ghost", "shadyLady"],
    "textHierarchy": ["richBlack"]
  }
